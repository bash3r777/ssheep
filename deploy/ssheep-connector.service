[Unit]
Description=ssheep connector (flock address book and relay)
Documentation=https://ssheep.xyz
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# The connector holds no secrets. It needs the public roster and its own TLS
# certificate, both of which live in its state directory.
Environment=SSHEEP_DIR=/var/lib/ssheep
ExecStart=/usr/local/bin/ssheep connector
Restart=always
RestartSec=3

# A connector is a small, blind relay. Give it as little as it needs.
DynamicUser=yes
StateDirectory=ssheep
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LimitNOFILE=65536
# Other machines need an address they can dial. Add it to ExecStart if the
# connector is behind a NAT or has more than one address:
#   --addr flock.example.com:7000      (when enrolled in a flock)
#   --advertise flock.example.com:7000 (a standalone, --public relay)

[Install]
WantedBy=multi-user.target
