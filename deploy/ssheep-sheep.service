[Unit]
Description=ssheep sheep (this machine's place in the flock)
Documentation=https://ssheep.xyz
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Install the ticket first:
#   ssheep sheep "<ticket>" --install-only
Environment=SSHEEP_DIR=/var/lib/ssheep
ExecStart=/usr/local/bin/ssheep sheep
Restart=always
RestartSec=5

# A sheep holds only its own private key.
DynamicUser=no
User=ssheep
Group=ssheep
StateDirectory=ssheep
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
